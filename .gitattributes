# Ensure consistent line endings
* text=auto eol=lf

# Python files
*.py text eol=lf

# Shell scripts
*.sh text eol=lf

# YAML files
*.yml text eol=lf
*.yaml text eol=lf

# Markdown
*.md text eol=lf

# JSON
*.json text eol=lf

# TOML
*.toml text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mp4 binary
*.mkv binary
*.webm binary
*.m4a binary
*.mp3 binary
*.opus binary
*.mov binary

# Archives
*.zip binary
*.tar.gz binary
*.tgz binary
*.rar binary
*.7z binary

# Lock files
package-lock.json text eol=lf
yarn.lock text eol=lf
Pipfile.lock text eol=lf
