# Telegram bot token from @BotFather (required)
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Where per-job download directories are created
DOWNLOAD_DIR=./downloads

# Maximum number of downloads running at the same time
CONCURRENT_DOWNLOADS=2

# Reject single files larger than this (Telegram Bot API limit is 50 MB).
# Also passed to yt-dlp as --max-filesize, so an oversized download is refused
# before the bytes are written rather than after.
MAX_FILE_SIZE_MB=50

# Refuse media longer than this many seconds. Enforced from the metadata yt-dlp
# reports before it starts downloading.
MAX_DURATION_SECONDS=600

# Comma-separated Telegram user IDs, e.g. 123456789,987654321. This is the bot's
# only access control, so a value that is empty or contains a non-id stops the bot
# at startup rather than silently leaving it open.
ALLOWED_USERS=

# Set to 1 to run a deliberately public bot. Only do this if anyone who finds the
# bot is meant to be able to spend your bandwidth, disk and platform quota.
ALLOW_PUBLIC=

# Port for the aiohttp health and metrics server (PORT wins over HEALTH_PORT)
PORT=8080
HEALTH_PORT=8080

# Interface the health server binds to (0.0.0.0 inside Docker/Render)
HEALTH_BIND=127.0.0.1

# Seconds before an extraction subprocess or ffprobe is killed
SUBPROCESS_TIMEOUT=180
FFPROBE_TIMEOUT=10

# Set to polling to force long polling; otherwise a webhook is used when
# RENDER_EXTERNAL_HOSTNAME or WEBHOOK_URL is present
BOT_MODE=
RENDER_EXTERNAL_HOSTNAME=
WEBHOOK_URL=
