# Telegram bot token from @BotFather (required)
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Where per-job download directories are created
DOWNLOAD_DIR=./downloads

# Maximum number of downloads running at the same time
CONCURRENT_DOWNLOADS=2

# Reject single files larger than this (Telegram Bot API limit is 50 MB)
MAX_FILE_SIZE_MB=50

# Comma-separated Telegram user IDs; empty means the bot is public
ALLOWED_USERS=

# Port for the aiohttp health and metrics server (PORT wins over HEALTH_PORT)
PORT=8080
HEALTH_PORT=8080

# Interface the health server binds to (0.0.0.0 inside Docker/Render)
HEALTH_BIND=127.0.0.1

# Seconds before an extraction subprocess or ffprobe is killed
SUBPROCESS_TIMEOUT=180
FFPROBE_TIMEOUT=10

# Set to polling to force long polling; otherwise a webhook is used when
# RENDER_EXTERNAL_HOSTNAME or WEBHOOK_URL is present
BOT_MODE=
RENDER_EXTERNAL_HOSTNAME=
WEBHOOK_URL=
