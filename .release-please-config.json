{
  "packages": {
    ".": {
      "package-name": "scraping-bot",
      "release-type": "python",
      "changelog-path": "CHANGELOG.md"
    }
  },
  "changelog-sections": [
    {
      "section": "Added",
      "type": "feat"
    },
    {
      "section": "Changed",
      "type": "refactor"
    },
    {
      "section": "Fixed",
      "type": "fix"
    },
    {
      "section": "Performance",
      "type": "perf"
    },
    {
      "section": "Documentation",
      "type": "docs"
    },
    {
      "section": "Dependencies",
      "type": "chore(deps)"
    },
    {
      "section": "Tests",
      "type": "test"
    },
    {
      "section": "CI",
      "type": "ci"
    },
    {
      "section": "Build",
      "type": "build"
    },
    {
      "section": "Maintenance",
      "type": "chore"
    }
  ]
}
